# Copy this file to .env and fill it in.

# Port the server listens on.
PORT=8787

# Which model backend to use:
#   mock   -> built-in demo model, no API key needed (default)
#   openai -> any OpenAI-compatible API: OpenAI, Ollama, vLLM, LM Studio,
#             llama.cpp server, Together, Groq... or YOUR OWN trained model.
PROVIDER=mock

# Only used when PROVIDER=openai.
# Examples:
#   OpenAI:           https://api.openai.com/v1
#   Ollama (local):   http://localhost:11434/v1
#   vLLM / your model http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL=gpt-4o-mini

# Personality of the assistant. The app can override this per user in Settings.
SYSTEM_PROMPT=You are Nova AI, a helpful, friendly assistant. Reply in the same language the user writes in (Hindi, Hinglish or English).

# Optional: if set, the app must send this token (Settings -> API token).
# Set this before you put the server on the internet.
API_TOKEN=

# Optional: save every finished chat to data/conversations.jsonl so you can
# use it later as a training dataset. 1 = on, anything else = off.
SAVE_CHATS=0
