generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A one-time SMS login code for a phone number. Not linked to User by FK
// since a brand-new phone number won't have a User row yet — request/
// verify/complete-profile all key off the raw phone string instead.
model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

enum Role {
  USER
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  GAME_STAKE
  GAME_PAYOUT
  BONUS
  DEPOSIT_BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum MarketStatus {
  OPEN
  SUSPENDED
  SETTLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

model User {
  id                   String    @id @default(uuid())
  email                String?   @unique
  passwordHash         String?
  phone                String?   @unique
  firstName            String
  lastName             String
  dateOfBirth          DateTime
  country              String
  role                 Role      @default(USER)
  kycStatus            KycStatus @default(NOT_STARTED)

  // Responsible gambling
  isSelfExcluded       Boolean   @default(false)
  selfExclusionUntil   DateTime?
  depositLimitDaily    Decimal?  @db.Decimal(12, 2)
  depositLimitWeekly   Decimal?  @db.Decimal(12, 2)
  depositLimitMonthly  Decimal?  @db.Decimal(12, 2)

  // Daily login bonus (server-authoritative — see gameEngineService)
  dailyStreak          Int       @default(0)
  lastDailyClaimAt     DateTime?

  // Provably-fair game RNG state — see fairnessService.ts. serverSeed is
  // never exposed to the client until rotated; serverSeedHash is shown
  // upfront so a player can verify, after rotation, that it wasn't
  // changed mid-play.
  fairnessServerSeed     String?
  fairnessServerSeedHash String?
  fairnessClientSeed     String?
  fairnessNonce          Int      @default(0)

  // Payout bank account for withdrawals. Required before a withdrawal is
  // accepted — see the check in wallet.routes.ts POST /withdraw.
  payoutAccountHolderName String?
  payoutAccountNumber     String?
  payoutIfsc              String?

  // One-time first-deposit bonus, see paymentService.ts / wallet.routes.ts.
  firstDepositBonusClaimed Boolean @default(false)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  wallet               Wallet?
  revealedSeeds        RevealedServerSeed[]
  transactions         Transaction[]
  bets                 Bet[]
  gameRounds           GameRound[]
  kycVerifications     KycVerification[]
  supportTickets       SupportTicket[]
}

model KycVerification {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  provider            String
  providerReferenceId String?
  status              KycStatus @default(PENDING)
  rawResult           Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("GBP")

  // Bonus funds already added to `balance` (so they're immediately
  // playable) but not yet withdrawable until `wageringProgress` reaches
  // `wageringRequired` — standard "wagering requirement" mechanic. Both
  // reset to 0 once met. See paymentService.ts (grant) and
  // gameEngineService.ts (progress) and wallet.routes.ts (withdraw gate).
  lockedBonus       Decimal @default(0) @db.Decimal(12, 2)
  wageringRequired  Decimal @default(0) @db.Decimal(12, 2)
  wageringProgress  Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  type                TransactionType
  amount              Decimal           @db.Decimal(12, 2)
  status              TransactionStatus @default(PENDING)
  provider            String?
  providerReferenceId String?
  betId               String?
  bet                 Bet?              @relation(fields: [betId], references: [id])
  createdAt           DateTime          @default(now())
}

model Sport {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  events Event[]
}

model Event {
  id        String      @id @default(uuid())
  sportId   String
  sport     Sport       @relation(fields: [sportId], references: [id])
  name      String
  startTime DateTime
  status    EventStatus @default(SCHEDULED)
  markets   Market[]
  createdAt DateTime    @default(now())
}

model Market {
  id         String       @id @default(uuid())
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id])
  name       String
  status     MarketStatus @default(OPEN)
  selections Selection[]
  createdAt  DateTime     @default(now())
}

model Selection {
  id        String   @id @default(uuid())
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id])
  name      String
  odds      Decimal  @db.Decimal(8, 2)
  isWinner  Boolean?
  bets      Bet[]
}

// One round of a real-money "game" (see gameEngineService.ts). Outcomes
// are "provably fair" (HMAC-SHA256 of serverSeed/clientSeed/nonce — see
// fairnessService.ts) — a player can independently recompute the result
// once serverSeedHash's underlying seed is revealed via seed rotation.
// This is NOT the same as accredited RNG certification, which a real
// casino licence still requires; that is a compliance step outside this
// codebase.
model GameRound {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  gameKey        String
  gameType       String   // "coinflip" | "dice"
  target         Int?     // dice only: the roll-under target the player chose
  stake          Decimal  @db.Decimal(12, 2)
  multiplier     Decimal  @db.Decimal(8, 4)
  payout         Decimal  @db.Decimal(12, 2)
  won            Boolean
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime @default(now())
}

// A server seed's value is only ever revealed once rotated out — this is
// what lets a player verify past rounds played under its hash.
model RevealedServerSeed {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  serverSeed     String
  serverSeedHash String
  createdAt      DateTime @default(now())
}

// Raised when a user's issue isn't solved by the in-app FAQ (see
// support.routes.ts). Shown to staff on the priority support dashboard
// (public/admin-support.html) so real escalations get a real response.
model SupportTicket {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  topic      String
  message    String?
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
}

model Bet {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  selectionId     String
  selection       Selection     @relation(fields: [selectionId], references: [id])
  stake           Decimal       @db.Decimal(12, 2)
  odds            Decimal       @db.Decimal(8, 2)
  potentialPayout Decimal       @db.Decimal(12, 2)
  status          BetStatus     @default(PENDING)
  createdAt       DateTime      @default(now())
  settledAt       DateTime?
  transactions    Transaction[]
}
