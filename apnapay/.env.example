# Copy this file to .env and fill it in.

# Port the server listens on
PORT=3000

# Public address of this payment website (used in payment links and webhook URLs)
BASE_URL=https://pay.yourdomain.in

# Set to 1 when running behind Caddy / Nginx / Cloudflare (needed for secure cookies)
TRUST_PROXY=1

# Where the database is stored. Back this folder up!
DATA_DIR=./data

# Neon / any Postgres. Leave empty to use the built-in local database in DATA_DIR.
DATABASE_URL=
