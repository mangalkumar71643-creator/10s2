<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so you can test with a computer on your WiFi (http://192.168.x.x:3000).
     Use https for the real online server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
